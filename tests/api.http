@profileUserId = 4
@otherTestUserId = REPLACE_WITH_OTHER_TEST_USER_ID
@otherTestAuthToken = REPLACE_WITH_LOGIN_TOKEN
# Run the Login request below and paste the returned token here.
@authToken = REPLACE_WITH_LOGIN_TOKEN
