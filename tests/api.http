### Existing title with credits: expected 200 and a non-empty array
GET {{baseUrl}}/api/titles/{{titleWithCredits}}/credits

> {%
    function assert(condition, message) {
        if (!condition) throw new Error(message);
    }

    client.test("Existing title returns credits", function () {
        assert(response.status === 200, "Expected 200");
        assert(Array.isArray(response.body.items), "Expected an array");
        assert(response.body.items.length > 0, "Use a title with credits");
    });

    client.test("Credit DTO has the expected attributes and types", function () {
        assert(Array.isArray(response.body.items) && response.body.items.length > 0, "Expected credits");
        const expectedKeys = ["personUri", "name", "ordering", "category", "job", "character", "knownFor"].sort();
        response.body.items.forEach(credit => {
            assert(JSON.stringify(Object.keys(credit).sort()) === JSON.stringify(expectedKeys), "Unexpected DTO attributes");
            assert(typeof credit.personUri === "string" && /^\/api\/people\/nm[0-9]{7,8}$/.test(credit.personUri), "Invalid personUri");
            ["name", "category", "job", "character"].forEach(key => {
                assert(credit[key] === null || typeof credit[key] === "string", "Invalid " + key);
            });
            assert(credit.ordering === null || Number.isInteger(credit.ordering), "Invalid ordering");
            assert(typeof credit.knownFor === "boolean", "Invalid knownFor");
        });
    });

    client.test("Credits hide database identifiers", function () {
        assert(Array.isArray(response.body.items) && response.body.items.length > 0, "Expected credits");
        response.body.items.forEach(credit => {
            ["id", "tconst", "nconst"].forEach(key => {
                assert(!(key in credit), "Database field leaked: " + key);
            });
        });
    });

    client.test("Credits have ascending ordering with null last", function () {
        assert(Array.isArray(response.body.items) && response.body.items.length > 0, "Expected credits");
        let nullSeen = false;
        let previous = -Infinity;
        response.body.items.forEach(credit => {
            if (credit.ordering === null) {
                nullSeen = true;
            } else {
                assert(!nullSeen, "Non-null ordering after null");
                assert(Number.isInteger(credit.ordering) && credit.ordering >= previous, "Ordering must be ascending");
                previous = credit.ordering;
            }
        });
    });
%}

