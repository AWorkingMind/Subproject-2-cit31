### Second page with up to ten titles
GET {{baseUrl}}/api/titles?page=2

> {%
    function assert(condition, message) {
        if (!condition) throw new Error(message);
    }

    client.test("Second page", function () {
        assert(response.status === 200, "Expected 200");
        assert(response.body.page === 2, "Expected page 2");
        assert(response.body.pageSize === 10, "Expected pageSize 10");
        assert(response.body.items.length <= 10, "Too many titles");
    });

    client.test("Second page does not repeat first page titles", function () {
        const savedUris = client.global.get("firstPageTitleUris");
        assert(typeof savedUris === "string", "Run the first page request before this request");
        const firstPageUris = JSON.parse(savedUris);
        const repeatedTitles = response.body.items.filter(title => firstPageUris.includes(title.uri));
        assert(repeatedTitles.length === 0, "Repeated titles: " + repeatedTitles.map(title => title.uri).join(", "));
    });
%}

