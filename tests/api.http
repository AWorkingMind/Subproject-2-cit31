# Verified in the configured database: existing title without credits.
@titleWithoutCredits = tt10008688
@missingTitle = tt9999999
@coPlayerPerson = nm0000002
# Verified in the configured database: existing person with no co-players.
@personWithoutCoPlayers = nm0000001

