### Co-players default page (use an existing person with co-players)
GET {{baseUrl}}/api/people/{{coPlayerPerson}}/co-players

> {%
    client.global.clear("firstPageCoPlayerUris");
    client.global.clear("firstPageCoPlayerLastFrequency");

    client.test("Co-players pagination and DTO", function () {
        client.assert(response.status === 200, "Expected 200");
        const body = response.body;
        client.assert(body.page === 1 && body.pageSize === 20, "Invalid pagination");
        client.assert(typeof body.hasNextPage === "boolean", "Missing hasNextPage");
        client.assert(Array.isArray(body.items) && body.items.length > 0 && body.items.length <= 20, "Use a person with co-players");
        client.assert(!body.hasNextPage || body.items.length === 20, "A page with more results must be full");
        let previousFrequency = Infinity;
        const uris = [];
        body.items.forEach(person => {
            client.assert(JSON.stringify(Object.keys(person).sort()) === JSON.stringify(["frequency", "name", "personUri"]), "Unexpected DTO attributes");
            client.assert(typeof person.personUri === "string" && /^\/api\/people\/nm[0-9]{7,8}$/.test(person.personUri), "Invalid personUri");
            client.assert(person.personUri !== "/api/people/{{coPlayerPerson}}", "Person must not be their own co-player");
            client.assert(person.name === null || typeof person.name === "string", "Invalid name");
            client.assert(Number.isSafeInteger(person.frequency) && person.frequency >= 1, "Invalid frequency");
            client.assert(person.frequency <= previousFrequency, "Frequency must be descending");
            client.assert(!uris.includes(person.personUri), "Duplicate co-player");
            previousFrequency = person.frequency;
            uris.push(person.personUri);
        });
        client.global.set("firstPageCoPlayerUris", JSON.stringify(uris));
        client.global.set("firstPageCoPlayerLastFrequency", previousFrequency);
    });
%}

### Co-players second page (run Co-players default page first)
GET {{baseUrl}}/api/people/{{coPlayerPerson}}/co-players?page=2

> {%
    client.test("Co-players second page does not repeat the first page", function () {
        client.assert(response.status === 200, "Expected 200");
        const body = response.body;
        client.assert(body.page === 2 && body.pageSize === 20, "Invalid pagination");
        client.assert(typeof body.hasNextPage === "boolean", "Missing hasNextPage");
        client.assert(Array.isArray(body.items) && body.items.length <= 20, "Expected up to twenty co-players");
        const savedUris = client.global.get("firstPageCoPlayerUris");
        client.assert(typeof savedUris === "string", "Run Co-players default page first");
        const firstPageUris = JSON.parse(savedUris);
        let previousFrequency = Number(client.global.get("firstPageCoPlayerLastFrequency"));
        body.items.forEach(person => {
            client.assert(!firstPageUris.includes(person.personUri), "Repeated co-player");
            client.assert(Number.isSafeInteger(person.frequency) && person.frequency >= 1 && person.frequency <= previousFrequency, "Frequency must be positive and descending across pages");
            previousFrequency = person.frequency;
        });
    });
%}

