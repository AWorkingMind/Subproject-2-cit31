### Individual person (run People default page first)
< {%
    const savedUris = client.global.get("firstPagePeopleUris");
    assert(typeof savedUris === "string", "Run People default page before this request");
    const uris = JSON.parse(savedUris);
    assert(uris.length > 0, "The database must contain at least one person");
    request.variables.set("personUri", uris[0]);
%}
GET {{baseUrl}}{{personUri}}

> {%
    function assert(condition, message) {
        if (!condition) throw new Error(message);
    }

    client.test("Individual person DTO", function () {
        assert(response.status === 200, "Expected 200");
        const person = response.body;
        const expectedUri = JSON.parse(client.global.get("firstPagePeopleUris"))[0];
        assert(person.uri === expectedUri, "Unexpected person URI");
        assert(person.name === null || typeof person.name === "string", "Invalid name");
        assert(person.birthYear === null || Number.isInteger(person.birthYear), "Invalid birthYear");
        assert(person.deathYear === null || Number.isInteger(person.deathYear), "Invalid deathYear");
        assert(person.coPlayersUri === expectedUri + "/co-players", "Invalid coPlayersUri");
        assert(person.wordsUri === expectedUri + "/words", "Invalid wordsUri");
        assert(!("primaryName" in person) && !("name_rating" in person), "Database fields leaked into DTO");
    });
%}

