### Access control: capture account A's bookmarks IDs
GET {{baseUrl}}/api/bookmarks
Authorization: Bearer {{authToken}}

> {%
    client.global.clear("accessControl_bookmark_id");
    client.test("Account A has bookmarks to check", function () {
        client.assert(response.status === 200 && Array.isArray(response.body.items) && response.body.items.length > 0, "Seed bookmarks for account A first");
        client.global.set("accessControl_bookmark_id", JSON.stringify(response.body.items.map(item => item.bookmark_id)));
    });
%}

### Access control: account B cannot see account A's bookmarks
GET {{baseUrl}}/api/bookmarks
Authorization: Bearer {{otherTestAuthToken}}

> {%
    client.test("Account B has separate bookmarks", function () {
        client.assert(response.status === 200 && Array.isArray(response.body.items), "Expected account B's list");
        const captured = client.global.get("accessControl_bookmark_id");
        client.assert(captured, "Run the matching account A request first");
        const ids = JSON.parse(captured);
        client.assert(response.body.items.every(item => !ids.includes(item.bookmark_id)), "Account B received account A's data");
    });
%}

